{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "include": [
    "src/main.ts",
    "src/nest-app.module.ts",
    "src/nest/**/*.ts",
    "src/lib/authTokens.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/routes",
    "src/middleware",
    "src/app.ts",
    "src/server.ts"
  ]
}